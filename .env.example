# Copie para .env.local (ignorado pelo git) e preencha.
# Para trocar de projeto Supabase, só estes valores mudam.
# Painel do Supabase > Project Settings > API

# --- Navegador (chaves públicas, podem ir para o front-end) ---
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_REF

# --- Servidor (as server functions leem process.env) ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=SEU_PROJECT_REF

# SECRETA: ignora o RLS. Usada só para convidar pacientes (criarPaciente).
# Nunca commitar, nunca usar com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
